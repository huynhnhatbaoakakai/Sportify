<?xml version="1.0" encoding="UTF-8"?>

<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
    version="3.2">

    <persistence-unit
        name="sportifyPU"
        transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <!-- Entity  -->
        <class>com.sportify.model.ChatMessage</class>
        <class>com.sportify.model.SportField</class>
        <class>com.sportify.model.Review</class>
        <class>com.sportify.model.Booking</class>
        <properties>

            <!-- Kết nối SQL -->
            <property
                name="jakarta.persistence.jdbc.driver"
                value="org.postgresql.Driver"/>

            <property
                name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5432/sporttrent"/>

            <property
                name="jakarta.persistence.jdbc.user"
                value="postgres"/>

            <property
                name="jakarta.persistence.jdbc.password"
                value="123"/>

           
            <property
                name="hibernate.dialect"
                value="org.hibernate.dialect.PostgreSQLDialect"/>

            <property
                name="hibernate.hbm2ddl.auto"
                value="validate"/>

            <property
                name="hibernate.show_sql"
                value="true"/>

            <property
                name="hibernate.format_sql"
                value="true"/>

        </properties>
    </persistence-unit>

</persistence>
