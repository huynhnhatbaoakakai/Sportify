<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Đăng nhập - Sportify</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eafaf1 0%, #f4fbf8 50%, #e9f7f0 100%);
    }

    .login-container {
        background: #ffffff;
        width: 100%;
        max-width: 400px;
        margin: 20px;
        border-radius: 16px;
        box-shadow: 0 15px 35px rgba(30, 130, 76, 0.15);
        padding: 40px 36px 32px 36px;
        text-align: center;
        border-top: 6px solid #2ecc71;
    }

    .logo-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 24px;
    }

    .logo-wrap img {
        width: 90px;
        height: 90px;
        object-fit: contain;
        margin-bottom: 8px;
    }

    .brand-name {
        font-size: 28px;
        font-weight: 800;
        color: #1a7a4c;
        letter-spacing: 1px;
    }

    .brand-sub {
        font-size: 14px;
        color: #2ecc71;
        font-weight: 500;
        margin-top: 2px;
    }

    .form-title {
        font-size: 20px;
        color: #1e824c;
        margin: 20px 0 24px 0;
        font-weight: 600;
    }

    .error-message {
        background: #fdecea;
        color: #c0392b;
        border: 1px solid #f5b7b1;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 18px;
        text-align: left;
    }

    .input-group {
        text-align: left;
        margin-bottom: 18px;
    }

    .input-group label {
        display: block;
        font-size: 13px;
        color: #333;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper input {
        width: 100%;
        padding: 12px 14px 12px 40px;
        border: 1.5px solid #d7ecdf;
        border-radius: 10px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: #f8fdfa;
    }

    .input-wrapper input:focus {
        border-color: #2ecc71;
        box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.15);
        background: #ffffff;
    }

    .input-wrapper .icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        fill: #2ecc71;
    }

    .options-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        margin-bottom: 22px;
        color: #555;
    }

    .options-row a {
        color: #1e824c;
        text-decoration: none;
        font-weight: 600;
    }

    .options-row a:hover {
        text-decoration: underline;
    }

    .options-row label {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

    .btn-login {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #2ecc71, #1e824c);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.1s;
    }

    .btn-login:hover {
        opacity: 0.92;
    }

    .btn-login:active {
        transform: scale(0.98);
    }

    .register-text {
        margin-top: 22px;
        font-size: 13px;
        color: #555;
    }

    .register-text a {
        color: #1e824c;
        font-weight: 700;
        text-decoration: none;
    }

    .register-text a:hover {
        text-decoration: underline;
    }
</style>
</head>
<body>

    <div class="login-container">
        <div class="logo-wrap">
            <img src="data:image/png;base64," alt="Sportify Logo">
        </div>

        <div class="form-title">Đăng nhập tài khoản</div>

        <%
            String error = request.getParameter("error");
            if (error != null) {
        %>
        <div class="error-message">
            Tài khoản hoặc mật khẩu không chính xác. Vui lòng thử lại.
        </div>
        <%
            }
        %>

        <form action="login" method="post">
            <div class="input-group">
                <label for="username">Tài khoản</label>
                <div class="input-wrapper">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M12 12c2.7 0 8 1.34 8 4v2H4v-2c0-2.66 5.3-4 8-4zm0-2a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/></svg>
                    <input type="text" id="username" name="username" placeholder="Nhập tài khoản" required autofocus>
                </div>
            </div>

            <div class="input-group">
                <label for="password">Mật khẩu</label>
                <div class="input-wrapper">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M12 17a2 2 0 0 0 2-2 2 2 0 0 0-2-2 2 2 0 0 0-2 2 2 2 0 0 0 2 2zm6-9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2h1V7a5 5 0 0 1 10 0v1h1zM12 4a3 3 0 0 0-3 3v1h6V7a3 3 0 0 0-3-3z"/></svg>
                    <input type="password" id="password" name="password" placeholder="Nhập mật khẩu" required>
                </div>
            </div>

            <div class="options-row">
                <label>
                    <input type="checkbox" name="remember"> Ghi nhớ đăng nhập
                </label>
                <a href="forgot-password.jsp">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-login">ĐĂNG NHẬP</button>
        </form>

        <div class="register-text">
            Chưa có tài khoản? <a href="register.jsp">Đăng ký ngay</a>
        </div>
    </div>

</body>
</html>
